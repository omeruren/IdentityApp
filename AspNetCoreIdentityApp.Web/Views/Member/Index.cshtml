@model UserViewModel
@{
    ViewData["Title"] = "Index";
}

<div class="row">
    <div class="col-md-4 offset-md-4">
        <user-picture-thumbnail class="rounded" style="width:300px"  picture-url="@Model.PictureUrl"></user-picture-thumbnail>
    </div>
</div>
<div class="row">
    <div class="col-md-6 offset-md-3">

        <h1>User Info </h1>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>User Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.UserName</td>
                    <td>@Model.Email</td>
                    <td>@Model.Phone</td>
                </tr>
            </tbody>
        </table>



      

    </div>
</div>