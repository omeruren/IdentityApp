@model AuthenticatiorViewModel
@{
    ViewData["Title"] = "TwoFactor";
}

<h2>Two Factorial Authentication</h2>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
<div class="row">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-info text-center" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <div class="col-md-12">
        <form asp-action="TwoFactor" method="post">
            <div class="form-group">
                <label class="control-label" asp-for="TwoFactorType"></label>
                <select asp-for="TwoFactorType" class="form-control" asp-items="Html.GetEnumSelectList<TwoFactorialAuth>()">
                </select>

            </div>
            <br />
            <button type="submit" class="btn btn-primary">Verify</button>
        </form>
    </div>
</div>
