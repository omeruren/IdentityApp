@model ResetPasswordViewModel
@{
    ViewData["Title"] = "ResetPassword";
}
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<div class="row">
    <div class="col-md-4 offset-md-4">
        <div class="alert alert-info">Reset Password link going to be send to your mail address</div>
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <form method="post">
            <div class=" mb-3">
                <label for="Email" class="col-md-4 col-form-label" asp-for="Email"></label>

                <input asp-for="Email" class="form-control">
                <span class="form-text text-danger" asp-validation-for="Email"></span>
            </div>
            
            <button type="submit" class="btn btn-primary">Send</button>
        </form>

    </div>
</div>
