@using System.Security.Claims
@if (User.Identity!.IsAuthenticated)
{


    <ul class="navbar-nav me-0">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                @User.Identity.Name
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Member" asp-action="Index">Profile</a></li>
                <a class="dropdown-item" asp-controller="Member" asp-action="ChangePassword">Change Password</a>

                <a class="dropdown-item" asp-controller="Member" asp-action="UserEdit">Edit Profile</a>
                <a class="dropdown-item" asp-controller="Member" asp-action="Claims">Claims</a>

                @if (User.HasClaim(x => x.Type == ClaimTypes.Role &&  x.Value == "Admin"))
                {

                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin Page</a></li>
                }

                <li><a class="dropdown-item" asp-controller="Member" asp-action="TwoFactor">Two Factorial Auth</a></li>
                <li><a class="dropdown-item" asp-route-returnurl="/Home/Index" asp-controller="Member" asp-action="Logout">Sign Out</a></li>

            </ul>
        </li>
    </ul>
}
else
{
    <a class="btn btn-outline-success mx-1" asp-controller="Home" asp-action="SignUp">Sign Up</a>
    <a class="btn btn-outline-success" asp-controller="Home" asp-action="SignIn">Sign In</a>
}