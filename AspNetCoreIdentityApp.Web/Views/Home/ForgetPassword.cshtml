@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ResetPassword";
}
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<div class="row">
    <div class="col-md-4 offset-md-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center" role="alert">
                @TempData["SuccessMessage"]
            </div>
        }
        @* <div class="alert alert-info">Reset Password link going to be send to your mail address</div> *@
        <div class="text-danger" asp-validation-summary="ModelOnly" role="alert"></div>
        <form method="post">
            <div class=" mb-3">
                <label for="Email" class="col-md-4 col-form-label" asp-for="Email"></label>

                <input asp-for="Email" class="form-control">
                <small >Reset Password link going to be send to your mail address</small>
                <span class="form-text text-danger" asp-validation-for="Email"></span>
            </div>
            
            <button type="submit" class="btn btn-primary">Send</button>
        </form>

    </div>
</div>
