@model UserEditViewModel
@{
    ViewData["Title"] = "UserEdit";
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
<div class="row">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-info text-center" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="col-md-6 offset-md-3">
        <h2>Edit  User</h2>
        <form asp-controller="Member" asp-action="UserEdit" method="post" enctype="multipart/form-data">

            <div class="row mb-3">
                <label for="UserName" class="col-md-4 col-form-label" asp-for="UserName"></label>
                <div class="col-md-8">
                    <input asp-for="UserName" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="UserName"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="Email" class="col-md-4 col-form-label" asp-for="Email"></label>
                <div class="col-md-8">
                    <input asp-for="Email" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="Email"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="Phone" class="col-md-4 col-form-label" asp-for="Phone"></label>
                <div class="col-md-8">
                    <input asp-for="Phone" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="Phone"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="City" class="col-md-4 col-form-label" asp-for="City"></label>
                <div class="col-md-8">
                    <input asp-for="City" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="City"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="BirthDate" class="col-md-4 col-form-label" asp-for="BirthDate"></label>
                <div class="col-md-8">
                    <input asp-for="BirthDate" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="BirthDate"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="Gender" class="col-md-4 col-form-label" asp-for="Gender"></label>
                <div class="col-md-8">
                    <select asp-items="@ViewBag.Gender" asp-for="Gender">
                        <option>Select Gender</option>
                    </select>
                    <span class="form-text text-danger" asp-validation-for="Gender"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="Picture" class="col-md-4 col-form-label" asp-for="Picture"></label>
                <div class="col-md-8">
                    <input type="file" asp-for="Picture" class="form-control" />
                    <span class="form-text text-danger" asp-validation-for="Picture"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8 offset-md-4">

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </div>
        </form>
    </div>
</div>