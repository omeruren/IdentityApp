@model List<AdminModel.RoleViewModel>
@{
    ViewData["Title"] = "Index";
    int count = 0;
}


<div class="row">
    <div class="col-md-6 offset-md-2">
        <h1>Roles</h1>
    </div>
    <div class="col-md-2">

        <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Roles" asp-action="RoleCreate">Add Role</a>
    </div>

</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <table class="table table-striped">
            <thead>

                <tr>
                    <th>#</th>
                _    <th>Role Name</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.Name</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>



