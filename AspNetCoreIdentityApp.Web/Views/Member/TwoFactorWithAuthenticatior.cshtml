@model AuthenticatiorViewModel
@{
    ViewData["Title"] = "TwoFactorWithAuthenticatior";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Two Factorial Authentication</h1>

<div class="row">
    <div class="col-md-12">
        <div class="alert alert-info">
            1.Step : Scan the Qr code vie Google/Microsoft Authenticator App or apply code right below
        </div>
        <strong class="text-danger">Key </strong><strong class="text-primary">@Model.SharedKey</strong>

        <div class="alert alert-info mt-3">
            2.Step : Apply the code coming from your app
        </div>
        <form action="TwoFactorWithAuthenticatior" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="VerificationCode"></label>
                <input asp-for="VerificationCode" class="form-control"/>
                <span asp-validation-for="VerificationCode" class="text-danger"></span>

                <input hidden asp-for="AuthenticationUri"/>
                <input hidden asp-for="SharedKey"/>
                
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Activate" class="btn btn-success">
            </div>
        </form>
    </div>

</div>
