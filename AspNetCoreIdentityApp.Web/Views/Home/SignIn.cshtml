@model SignInViewModel
@{
    ViewData["Title"] = "SignIn";

}
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
<div class="row">
    
    <div class="col-md-4 offset-md-4">
        <h2>Sign In</h2>
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <form class="mb-1" asp-controller="Home" asp-action="SignIn" asp-route-returnurl="@Context.Request.Query["returnUrl"]" method="post">
            <div class=" mb-3">
                <label for="Email" class="col-md-4 col-form-label" asp-for="Email"></label>

                <input asp-for="Email" class="form-control">
                <span class="form-text text-danger" asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label for="Password" class="col-md-4 col-form-label" asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control">
                <span class="form-text text-danger" asp-validation-for="Password"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3 form-check">
                        <input class="form-check-input" asp-for="RememberMe">
                        <label class="form-check-label" for="RememberMe" asp-for="RememberMe"></label>
                    </div>
                </div>
                <div class="col-md-6 me-0">
                    <div>
                        <a class=" text-decoration-none float-end" asp-controller="Home" asp-action="ForgetPassword">Forgot Password ?</a>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Log in</button>

        </form>
            <a class="mt-1 btn btn-outline-primary" asp-action="FacebookLogin">Login With Facebook</a>
            <a class="mt-1 btn btn-outline-primary" asp-action="GoogleLogin">Login With Google</a>
    </div>
</div>
