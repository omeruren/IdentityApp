@model ChangePasswordViewModel
@{
    ViewData["Title"] = "ChangePassword";
}
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
<div class="row">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-info text-center" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="col-md-6 offset-md-3">
        <h2>Change Password</h2>
        <form method="post">

            <div class="row mb-3">
                <label for="OldPassword" class="col-md-4 col-form-label" asp-for="OldPassword"></label>
                <div class="col-md-8">
                    <input asp-for="OldPassword" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="OldPassword"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="NewPassword" class="col-md-4 col-form-label" asp-for="NewPassword"></label>
                <div class="col-md-8">
                    <input asp-for="NewPassword" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="NewPassword"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="ConfirmNewPassword" class="col-md-4 col-form-label" asp-for="ConfirmNewPassword"></label>
                <div class="col-md-8">
                    <input asp-for="ConfirmNewPassword" class="form-control">
                    <span class="form-text text-danger" asp-validation-for="ConfirmNewPassword"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8 offset-md-4">

                    <button type="submit" class="btn btn-primary">Reset Password</button>
                </div>
            </div>
        </form>
    </div>
</div>