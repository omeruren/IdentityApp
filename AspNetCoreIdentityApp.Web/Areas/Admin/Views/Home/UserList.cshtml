@model List<AdminModel.UserViewModel>
@{
    ViewData["Title"] = "UserList";
    int count = 0;
}

<table class="table table-striped">
    <thead>

        <tr>
            <th>#</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Options</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.UserName</td>
                <td>@item.Email</td>
                <td>
                    <user-role-names user-id="@item.UserId"></user-role-names>
                </td>
                <td>
                    <a class="btn btn-outline-primary" asp-controller="Roles" asp-action="AssignRoleToUser" asp-route-id="@item.UserId">Assign Role</a>
                </td>
            </tr>
        }
    </tbody>
</table>

