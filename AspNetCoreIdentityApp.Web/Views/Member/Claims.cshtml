@model List<ClaimViewModel>
@{
    ViewData["Title"] = "Claims";
}



<div class="row">
    <div class="col-md-6 offset-md-3">

        <h1>Claim List</h1>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Issuer</th>
                    <th>Type</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model)
                {
                    
                <tr>
                    <td>@item.Issuer</td>
                    <td>@item.Type</td>
                    <td>@item.Value</td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

