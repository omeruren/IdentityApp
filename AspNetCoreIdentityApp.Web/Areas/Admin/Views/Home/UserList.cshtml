@model List<UserViewModel>
@{
    ViewData["Title"] = "UserList";
    int count = 0;
}

<table class="table table-striped">
    <thead>

        <tr>
            <th>#</th>
            <th>User Name</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.UserName</td>
                <td>@item.Email</td>

            </tr>
        }
    </tbody>
</table>

