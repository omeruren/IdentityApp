@model List<AdminModel.RoleViewModel>
@{
    ViewData["Title"] = "Index";
    int count = 0;
}


<div class="row">
    <div class="col-md-6 offset-md-2">
        <h1>Roles</h1>
    </div>
    <div class="col-md-2">

        <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Roles" asp-action="RoleCreate">Add Role</a>
    </div>

</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-info text-center" role="alert">
                @TempData["SuccessMessage"]
            </div>
        }
        <table class="table table-striped">
            <thead>

                <tr>
                    <th>#</th>
                   <th>Role Name</th>
                   <th>Options</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td>@count</td>
                        <td>@item.Name</td>
                        <td>
                            <a  class="btn btn-outline-primary text-decoration-none" asp-area="Admin" asp-controller="Roles" asp-action="RoleUpdate" asp-route-id="@item.Id">Update</a>
                            <a  class="btn btn-outline-danger text-decoration-none my-1" asp-area="Admin" asp-controller="Roles" asp-action="RoleDelete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>



